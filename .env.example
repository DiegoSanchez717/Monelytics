# Local demonstration ONLY. Copy to .env and replace these before sharing an instance.
DATABASE_NAME=monelytics
DATABASE_USERNAME=monelytics
DATABASE_PASSWORD=LocalDatabase!2026
DEMO_PASSWORD=Monelytics!2026
ADMIN_PASSWORD=AdminDemo!2026
# Local HTTP/demo defaults. HTTPS/shared setups require true/false/false respectively.
COOKIE_SECURE=false
DEMO_ENABLED=true
API_DOCS_ENABLED=true
# Generate a new key with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep the key stable: existing MFA secrets become unreadable if you replace it.
MFA_ENCRYPTION_KEY=MTIzNDU2Nzg5MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTI=
FRONTEND_PORT=8080
BACKEND_PORT=8081
PUBLIC_BASE_URL=http://localhost:8080
MAIL_FROM=noreply@monelytics.local
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
# Free hosted questions: create a Groq Free-plan key without enabling billing.
# No key or no explicit Free-plan confirmation keeps the educational demo fallback active.
AI_PROVIDER=groq
# GROQ_API_KEY is also accepted and takes precedence if you already use that name.
AI_API_KEY=
AI_FREE_PLAN_CONFIRMED=false
AI_DAILY_REQUEST_LIMIT=40
AI_MODEL=openai/gpt-oss-20b
