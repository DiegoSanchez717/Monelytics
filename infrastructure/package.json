{
  "name": "monelytics-infrastructure",
  "version": "1.0.0",
  "private": true,
  "description": "Offline, provisioning-disabled AWS CDK reference for Monelytics",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test dist/test/*.test.js",
    "synth": "node ../scripts/deploy-aws.mjs",
    "free-plan:check": "node ../scripts/check-aws-free-plan.mjs",
    "audit": "node scripts/audit-dependencies.mjs",
    "deploy": "node ../scripts/deploy-aws.mjs --deploy"
  },
  "dependencies": {
    "aws-cdk-lib": "2.272.0",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "aws-cdk": "2.1145.0",
    "typescript": "5.9.3"
  },
  "engines": { "node": ">=24.12.0 <25" }
}
