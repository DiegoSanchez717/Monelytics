{
  "name": "monelytics-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "ng serve --host 0.0.0.0",
    "build": "ng build",
    "test": "ng test --watch=false",
    "lint": "eslint src",
    "format": "prettier --write src package.json angular.json *.mjs *.json",
    "format:check": "prettier --check src package.json angular.json *.mjs *.json"
  },
  "dependencies": {
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/forms": "21.2.25",
    "@angular/platform-browser": "21.2.25",
    "@angular/router": "21.2.25",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.26",
    "@angular/cli": "21.2.26",
    "@angular/compiler-cli": "21.2.25",
    "angular-eslint": "^21.0.0",
    "eslint": "^9.39.0",
    "jsdom": "^27.4.0",
    "prettier": "3.7.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
